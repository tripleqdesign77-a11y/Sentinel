# Advanced Security Platform - Environment Configuration
# ============================================================================# APPLICATION# ============================================================================NODE_ENV=developmentAPP_NAME=advanced-security-platformAPP_URL=http://localhost:3000API_URL=http://localhost:3001LOG_LEVEL=info
# ============================================================================# AWS CONFIGURATION# ============================================================================AWS_REGION=us-east-1AWS_ACCESS_KEY_ID=your_aws_access_keyAWS_SECRET_ACCESS_KEY=your_aws_secret_keyAWS_ACCOUNT_ID=your_aws_account_id
# EC2 ConfigurationEC2_KEY_PAIR=security-platform-keyEC2_SECURITY_GROUP=security-platform-sgEC2_INSTANCE_TYPE=t3.medium
# RDS ConfigurationRDS_INSTANCE_CLASS=db.t3.microRDS_ALLOCATED_STORAGE=20
# ============================================================================# DATABASE# ============================================================================DB_HOST=localhostDB_PORT=5432DB_USER=postgresDB_PASSWORD=your_secure_password_hereDB_NAME=security_platformDB_SSL=falseDB_POOL_MIN=2DB_POOL_MAX=10
# ============================================================================# REDIS (for caching & real-time)# ============================================================================REDIS_HOST=localhostREDIS_PORT=6379REDIS_PASSWORD=REDIS_DB=0
# ============================================================================# AI & ML APIs# ============================================================================CLAUDE_API_KEY=sk-ant-your-claude-api-keyCLAUDE_MODEL=claude-opus-4-1
# Vocode for voice AIVOCODE_API_KEY=your_vocode_api_keyVOCODE_ENGINE=google
# Threat prediction MLML_MODEL_PATH=./ml/models/threat-predictor.pklML_PREDICTION_THRESHOLD=0.75
# ============================================================================# COMMUNICATION & ALERTING# ============================================================================
# Twilio (Phone/SMS)TWILIO_ACCOUNT_SID=your_twilio_account_sidTWILIO_AUTH_TOKEN=your_twilio_auth_tokenTWILIO_PHONE_NUMBER=+1234567890TWILIO_SMS_FROM=+1234567890
# SlackSLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URLSLACK_BOT_TOKEN=xoxb-your-slack-bot-tokenSLACK_SIGNING_SECRET=your_slack_signing_secret
# Email (Mailgun)MAILGUN_DOMAIN=mg.yourdomain.comMAILGUN_API_KEY=your_mailgun_api_keyMAILGUN_FROM_EMAIL=alerts@yourdomain.com
# SMS AlertsSMS_ALERT_PHONE=+1234567890SMS_PROVIDER=twilio  # or 'aws_sns'
# ============================================================================# PAYMENT & BILLING# ============================================================================STRIPE_SECRET_KEY=sk_live_your_stripe_secret_keySTRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_keySTRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# PricingPRICING_STARTER=99900  # $999.00 in centsPRICING_PROFESSIONAL=249900  # $2,499.00PRICING_ENTERPRISE=499900  # $4,999.00
# ============================================================================# THREAT INTELLIGENCE & SCANNING# ============================================================================
# CellID (Tower detection)CELLID_API_KEY=your_cellid_api_key
# Shodan (Network scanning)SHODAN_API_KEY=your_shodan_api_key
# MITRE ATT&CK (Threat framework)MITRE_ATTACK_API_URL=https://raw.githubusercontent.com/mitre/cti/master
# Dark web monitoringDARK_WEB_MONITOR=falseDARK_WEB_API_KEY=your_dark_web_monitoring_key
# Threat intelligence feedsTHREAT_FEED_URLS=https://otx.alienvault.com/api/v1/pulses/subscribed
# ============================================================================# HONEYPOT CONFIGURATION# ============================================================================
# Honeypot VMsHONEYPOT_REGION=us-east-1HONEYPOT_IMAGE=ami-0c55b159cbfafe1f0  # UbuntuHONEYPOT_INSTANCE_TYPE=t3.microHONEYPOT_AUTO_SCALE=trueHONEYPOT_MIN_COUNT=1HONEYPOT_MAX_COUNT=10
# Honeypot ServicesHONEYPOT_SSH_PORT=22HONEYPOT_HTTP_PORT=80HONEYPOT_HTTPS_PORT=443HONEYPOT_MYSQL_PORT=3306HONEYPOT_ADMIN_PORT=8888
# Fake credentials (bait for attackers)HONEYPOT_ADMIN_USERNAME=adminHONEYPOT_ADMIN_PASSWORD=Admin@123HONEYPOT_DB_USERNAME=dbuserHONEYPOT_DB_PASSWORD=DbPassword123
# ============================================================================# SCANNER CONFIGURATION# ============================================================================
# Cell tower scanningSCANNER_TOWER_ENABLE=trueSCANNER_TOWER_INTERVAL=3600  # 1 hour in secondsSCANNER_TOWER_RADIUS=5000    # 5km radius
# APN scanningSCANNER_APN_ENABLE=trueSCANNER_APN_INTERVAL=3600
# Network scanningSCANNER_NETWORK_ENABLE=trueSCANNER_NETWORK_PORTS=22,80,443,3306,8080,8888
# ============================================================================# VOICE SYSTEM CONFIGURATION# ============================================================================
# Voice listeningVOICE_ENABLE=trueVOICE_PROVIDER=vocode  # or 'google'VOICE_SAMPLE_RATE=16000VOICE_LANGUAGE=en-US
# Voice commandsVOICE_COMMAND_TIMEOUT=30  # secondsVOICE_COMMAND_MAX_LENGTH=500  # characters
# Voice responseVOICE_RESPONSE_SPEED=1.0VOICE_RESPONSE_VOICE=professional  # or 'urgent', 'calm'
# Phone systemPHONE_NUMBER=+1234567890CALL_RECORDING=trueCALL_TRANSCRIPTION=true
# ============================================================================# SECURITY & COMPLIANCE# ============================================================================
# API SecurityAPI_KEY_PREFIX=sk_security_JWT_SECRET=your_jwt_secret_keyJWT_EXPIRATION=24hCORS_ORIGIN=http://localhost:3000,https://yourdomain.com
# OAuth / SSOOAUTH_ENABLE=falseOAUTH_GOOGLE_CLIENT_ID=your_google_client_idOAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
# EncryptionENCRYPTION_KEY=your_32_character_encryption_key_hereENCRYPTION_ALGORITHM=aes-256-cbc
# Audit loggingAUDIT_LOGGING=trueAUDIT_LOG_RETENTION_DAYS=365
# ComplianceCOMPLIANCE_SOC2=trueCOMPLIANCE_ISO27001=trueCOMPLIANCE_HIPAA=falseCOMPLIANCE_PCI_DSS=false
# ============================================================================# MONITORING & LOGGING# ============================================================================
# CloudWatchCLOUDWATCH_ENABLE=trueCLOUDWATCH_NAMESPACE=AdvancedSecurityPlatformCLOUDWATCH_LOG_GROUP=/aws/advanced-security-platform
# Datadog (optional)DATADOG_ENABLE=falseDATADOG_API_KEY=your_datadog_api_keyDATADOG_APP_KEY=your_datadog_app_key
# Error tracking (Sentry)SENTRY_ENABLE=falseSENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# ============================================================================# DEVELOPMENT & DEBUGGING# ============================================================================
# Debug modeDEBUG=advanced-security-platform:*DEBUG_LEVEL=info
# Test modeTEST_MODE=falseTEST_DATABASE_URL=postgresql://user:pass@localhost:5432/test_db
# Seed dataSEED_DEMO_DATA=trueSEED_DEMO_THREATS=trueSEED_DEMO_HONEYPOTS=true
# ============================================================================# DEPLOYMENT# ============================================================================
# DockerDOCKER_REGISTRY=your_docker_registryDOCKER_IMAGE_TAG=latest
# Kubernetes (if using)K8S_ENABLE=falseK8S_NAMESPACE=production
# Feature flagsFEATURE_VOICE_COMMANDS=trueFEATURE_HONEYPOTS=trueFEATURE_SCANNER=trueFEATURE_AI_CONVERSATIONS=trueFEATURE_THREAT_PREDICTION=trueFEATURE_MANAGED_SOC=false  # Enable when team grows
# ============================================================================# EXTERNAL SERVICES# ============================================================================
# GitHub (for CI/CD)GITHUB_TOKEN=ghp_your_github_tokenGITHUB_WEBHOOK_SECRET=your_webhook_secret
# Slack notificationsSLACK_CHANNEL_ALERTS=#security-alertsSLACK_CHANNEL_INCIDENTS=#incidentsSLACK_CHANNEL_DEPLOYMENTS=#deployments
# Status pageSTATUS_PAGE_ENABLE=trueSTATUS_PAGE_ID=your_status_page_id
# ============================================================================# RATE LIMITING & QUOTAS# ============================================================================
RATE_LIMIT_API_CALLS=1000  # per hourRATE_LIMIT_VOICE_COMMANDS=100  # per dayRATE_LIMIT_HONEYPOT_DEPLOYMENTS=10  # per day
# ============================================================================# NOTES# ============================================================================# 1. Never commit this file with real secrets to git# 2. Use .env.local for local development overrides# 3. In production, use AWS Secrets Manager or similar# 4. Rotate API keys regularly# 5. Use strong, unique passwords for all services
