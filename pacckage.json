{  "name": "advanced-security-platform",  "version": "1.0.0",  "description": "Next-generation threat detection with honeypot worlds, voice commands, and AI threat analysis",  "main": "backend/src/server.js",  "scripts": {    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../mobile && npm install",    "dev": "concurrently 'cd backend && npm run dev' 'cd frontend && npm run dev'",    "dev:backend": "cd backend && npm run dev",    "dev:frontend": "cd frontend && npm run dev",    "dev:mobile": "cd mobile && npm run dev",    "build": "npm run build:backend && npm run build:frontend && npm run build:mobile",    "build:backend": "cd backend && npm run build",    "build:frontend": "cd frontend && npm run build",    "build:mobile": "cd mobile && npm run build",    "test": "npm run test:backend && npm run test:frontend",    "test:backend": "cd backend && npm test",    "test:frontend": "cd frontend && npm test",    "test:integration": "cd backend && npm run test:integration",    "test:e2e": "npm run test:e2e",    "test:load": "cd backend && npm run test:load",    "test:security": "cd backend && npm run test:security",    "honeypot:deploy": "cd backend && npm run honeypot:deploy",    "voice:init": "cd backend && npm run voice:init",    "voice:test": "cd backend && npm run voice:test",    "scanner:start": "cd backend && npm run scanner:start",    "scanner:test": "cd backend && npm run scanner:test",    "ai-conversation:start": "cd backend && npm run ai-conversation:start",    "prediction:start": "cd backend && npm run prediction:start",    "prediction:train": "cd ml && python train.py",    "migrate": "cd backend && npm run migrate",    "migrate:rollback": "cd backend && npm run migrate:rollback",    "deploy": "bash scripts/deploy.sh",    "deploy:local": "docker-compose up",    "deploy:prod": "bash scripts/deploy.sh --production",    "docker:build": "docker-compose build",    "docker:push": "docker-compose push",    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",    "format": "prettier --write .",    "docs": "cd docs && npm run build",    "version": "npm --version && node --version && docker --version"  },  "keywords": [    "security",    "honeypot",    "threat-detection",    "AI",    "incident-response",    "voice-commands",    "cybersecurity"  ],  "author": "Security AI Team",  "license": "MIT",  "dependencies": {    "concurrently": "^8.2.2"  },  "devDependencies": {    "eslint": "^8.50.0",    "prettier": "^3.0.3"  },  "engines": {    "node": ">=18.0.0",    "npm": ">=9.0.0"  },  "repository": {    "type": "git",    "url": "https://github.com/yourusername/advanced-security-platform.git"  },  "bugs": {    "url": "https://github.com/yourusername/advanced-security-platform/issues"  },  "homepage": "https://github.com/yourusername/advanced-security-platform#readme"}
